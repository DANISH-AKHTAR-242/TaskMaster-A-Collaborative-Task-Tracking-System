generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER

  @@map("team_role")
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER

  @@map("project_role")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED

  @@map("task_status")
}

enum AttachmentStatus {
  PENDING
  READY
  FAILED
  DELETED

  @@map("attachment_status")
}

enum AiRequestStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("ai_request_status")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  DEAD_LETTER

  @@map("outbox_status")
}

model User {
  id                String                @id @default(uuid()) @db.Uuid
  email             String                @db.VarChar(320)
  passwordHash      String                @map("password_hash")
  displayName       String                @map("display_name") @db.VarChar(120)
  avatarUrl         String?               @map("avatar_url")
  emailVerifiedAt   DateTime?             @map("email_verified_at") @db.Timestamptz
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?             @map("deleted_at") @db.Timestamptz
  authSessions      AuthSession[]
  createdTeams      Team[]                @relation("TeamCreator")
  teamMemberships   TeamMember[]
  sentInvitations   TeamInvitation[]      @relation("InvitationSender")
  createdProjects   Project[]             @relation("ProjectCreator")
  projectMemberships ProjectMember[]      @relation("ProjectMembershipUser")
  addedProjectMembers ProjectMember[]     @relation("ProjectMembershipAdder")
  createdTasks      Task[]                @relation("TaskCreator")
  assignedTasks     Task[]                @relation("TaskAssignee")
  comments          TaskComment[]
  attachments       TaskAttachment[]
  auditLogs         AuditLog[]
  idempotencyKeys   IdempotencyKey[]
  receivedNotifications Notification[]    @relation("NotificationRecipient")
  actedNotifications Notification[]       @relation("NotificationActor")
  aiRequests        AiGenerationRequest[]

  @@map("users")
}

model AuthSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  tokenFamilyId    String        @map("token_family_id") @db.Uuid
  refreshTokenHash String        @unique @map("refresh_token_hash") @db.Char(64)
  replacedById     String?       @unique @map("replaced_by_id") @db.Uuid
  userAgent        String?       @map("user_agent")
  ipAddress        String?       @map("ip_address") @db.Inet
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       AuthSession?  @relation("SessionReplacement", fields: [replacedById], references: [id])
  replaces         AuthSession?  @relation("SessionReplacement")

  @@index([userId, revokedAt])
  @@index([tokenFamilyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Team {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(120)
  slug        String           @db.VarChar(80)
  createdBy   String           @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz
  creator     User             @relation("TeamCreator", fields: [createdBy], references: [id])
  members     TeamMember[]
  invitations TeamInvitation[]
  projects    Project[]
  auditLogs   AuditLog[]

  @@map("teams")
}

model TeamMember {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      TeamRole
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  removedAt DateTime? @map("removed_at") @db.Timestamptz
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId, removedAt])
  @@map("team_members")
}

model TeamInvitation {
  id         String    @id @default(uuid()) @db.Uuid
  teamId     String    @map("team_id") @db.Uuid
  email      String    @db.VarChar(320)
  role       TeamRole
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter    User      @relation("InvitationSender", fields: [invitedBy], references: [id])

  @@index([teamId, createdAt])
  @@map("team_invitations")
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  teamId      String          @map("team_id") @db.Uuid
  name        String          @db.VarChar(160)
  description String?
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator     User            @relation("ProjectCreator", fields: [createdBy], references: [id])
  members     ProjectMember[]
  tasks       Task[]
  notifications Notification[]
  aiRequests  AiGenerationRequest[]

  @@index([teamId, deletedAt])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  addedBy   String      @map("added_by") @db.Uuid
  joinedAt  DateTime    @default(now()) @map("joined_at") @db.Timestamptz
  removedAt DateTime?   @map("removed_at") @db.Timestamptz
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation("ProjectMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  adder     User        @relation("ProjectMembershipAdder", fields: [addedBy], references: [id])

  @@unique([projectId, userId])
  @@index([userId, removedAt])
  @@map("project_members")
}

model Task {
  id           String          @id @default(uuid()) @db.Uuid
  projectId    String          @map("project_id") @db.Uuid
  title        String          @db.VarChar(200)
  description  String?
  status       TaskStatus      @default(OPEN)
  dueAt        DateTime?       @map("due_at") @db.Timestamptz
  createdBy    String          @map("created_by") @db.Uuid
  assigneeId   String?         @map("assignee_id") @db.Uuid
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz
  version      Int             @default(1)
  searchVector Unsupported("tsvector")? @map("search_vector")
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User            @relation("TaskCreator", fields: [createdBy], references: [id])
  assignee     User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments     TaskComment[]
  attachments  TaskAttachment[]
  notifications Notification[]
  aiRequests   AiGenerationRequest[]

  @@index([projectId, status, deletedAt])
  @@index([assigneeId, status, dueAt])
  @@index([projectId, dueAt])
  @@index([createdAt])
  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt, id])
  @@map("task_comments")
}

model TaskAttachment {
  id               String           @id @default(uuid()) @db.Uuid
  taskId           String           @map("task_id") @db.Uuid
  uploadedBy       String           @map("uploaded_by") @db.Uuid
  storageProvider  String           @map("storage_provider") @db.VarChar(30)
  storageBucket    String           @map("storage_bucket") @db.VarChar(120)
  storageKey       String           @unique @map("storage_key")
  originalFilename String           @map("original_filename") @db.VarChar(255)
  contentType      String           @map("content_type") @db.VarChar(150)
  sizeBytes        BigInt           @map("size_bytes")
  checksumSha256   String?          @map("checksum_sha256") @db.Char(64)
  status           AttachmentStatus
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  task             Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader         User             @relation(fields: [uploadedBy], references: [id])

  @@index([taskId, status, deletedAt])
  @@map("task_attachments")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  teamId      String?  @map("team_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  actor       User?    @relation(fields: [actorUserId], references: [id])
  team        Team?    @relation(fields: [teamId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  key            String    @db.VarChar(200)
  method         String    @db.VarChar(10)
  route          String    @db.VarChar(300)
  requestHash    String    @map("request_hash") @db.Char(64)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user           User?     @relation(fields: [userId], references: [id])

  @@unique([userId, key, method, route])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(50)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz
  attemptCount  Int          @default(0) @map("attempt_count")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz
  lastError     String?      @map("last_error")
  notifications Notification[]

  @@index([status, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model Notification {
  id              String       @id @default(uuid()) @db.Uuid
  sourceEventId   String       @map("source_event_id") @db.Uuid
  recipientUserId String       @map("recipient_user_id") @db.Uuid
  actorUserId     String?      @map("actor_user_id") @db.Uuid
  projectId       String?      @map("project_id") @db.Uuid
  taskId          String?      @map("task_id") @db.Uuid
  type            String       @db.VarChar(100)
  payload         Json
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  readAt          DateTime?    @map("read_at") @db.Timestamptz
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz
  sourceEvent     OutboxEvent  @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)
  recipient       User         @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor           User?        @relation("NotificationActor", fields: [actorUserId], references: [id])
  project         Project?     @relation(fields: [projectId], references: [id])
  task            Task?        @relation(fields: [taskId], references: [id])

  @@unique([sourceEventId, recipientUserId])
  @@index([recipientUserId, createdAt, id])
  @@map("notifications")
}

model AiGenerationRequest {
  id                String          @id @default(uuid()) @db.Uuid
  requestedBy       String          @map("requested_by") @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  taskId            String?         @map("task_id") @db.Uuid
  purpose           String          @db.VarChar(50)
  provider          String          @db.VarChar(50)
  model             String          @db.VarChar(100)
  inputHash         String          @map("input_hash") @db.Char(64)
  status            AiRequestStatus
  promptTokens      Int?            @map("prompt_tokens")
  completionTokens  Int?            @map("completion_tokens")
  latencyMs         Int?            @map("latency_ms")
  providerRequestId String?         @map("provider_request_id")
  errorCode         String?         @map("error_code") @db.VarChar(100)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz
  requester         User            @relation(fields: [requestedBy], references: [id])
  project           Project         @relation(fields: [projectId], references: [id])
  task              Task?           @relation(fields: [taskId], references: [id])

  @@index([requestedBy, purpose, createdAt])
  @@map("ai_generation_requests")
}
